<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.lns.pogr.aacpdiagd</string>
	<key>ProgramArguments</key>
	<array>
		<string>/var/jb/usr/bin/aacpdiagd</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>ThrottleInterval</key>
	<integer>2</integer>
	<key>ProcessType</key>
	<string>Background</string>
	<key>StandardOutPath</key>
	<string>/var/tmp/com.lns.pogr.aacpdiag/daemon-stdout.log</string>
	<key>StandardErrorPath</key>
	<string>/var/tmp/com.lns.pogr.aacpdiag/daemon-stderr.log</string>
</dict>
</plist>
